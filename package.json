{
  "name": "dsh-find",
  "version": "0.3.9",
  "description": "Ctrl+F full-text search plus a local image/video browser across every workspace and conversation in DeepSeek Harness, executed entirely locally.",
  "type": "module",
  "license": "MIT",
  "author": "A-2788553793",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A-2788553793/dsh-find.git"
  },
  "homepage": "https://github.com/A-2788553793/dsh-find#readme",
  "bugs": {
    "url": "https://github.com/A-2788553793/dsh-find/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "search",
    "find",
    "full-text",
    "conversation",
    "ctrl-f"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
